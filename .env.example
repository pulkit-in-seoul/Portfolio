# Replace these placeholders in your local .env file or server environment.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Portfolio Contact <contact@your-verified-domain.com>"

# Optional: destination inbox (defaults to RESEND_FROM_EMAIL).
CONTACT_EMAIL="your-inbox@example.com"

# Optional: hosting platforms set PORT automatically.
# PORT=3001

# Optional: restrict cross-origin API calls to this exact frontend origin.
# If unset, the public contact API allows cross-origin requests.
# FRONTEND_ORIGIN=https://your-portfolio.example

# Set this at frontend build time only when the API is on another origin.
# Leave unset for the Vite dev proxy or a frontend served by the same Express app.
# VITE_API_URL=https://your-render-service.onrender.com